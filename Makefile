#################################################################################################################
#                                           VARIABLES SET                                                       #
#################################################################################################################
NAME = philo

CC = gcc
FLAGS = -Wall -Wextra -Werror -g #-fsanitize=address #-fsanitize=thread

SRCS = main.c init_struct.c clean.c utils.c error.c create_philo.c \
	eating.c monitor.c routine.c routine_utils.c

INCLUDES = philo.h

OBJS = ${addprefix ${OBJ_DIR}/,${SRCS:.c=.o}}
OBJ_DIR = objets/
#################################################################################################################
#                                           RULES COMPILATION                                                   #
#################################################################################################################
all: ${NAME}

${NAME}: ${OBJS}
	${CC} ${FLAGS} ${OBJS} ${EXTRA} -I ${INCLUDES} -o ${NAME}

${OBJ_DIR}/%.o: %.c ${INCLUDES}
	@mkdir -p ${OBJ_DIR}
	${CC} ${FLAGS} -c $< -o $@

#################################################################################################################
#                                           RULES CLEAN                                                         #
#################################################################################################################
clean:
	rm -rf ${OBJ_DIR}/ ${OBJS}

fclean: clean
	rm -rf ${NAME}

re: fclean all
#################################################################################################################
#                                           NO RELINK                                                           #
#################################################################################################################

.PHONY: all clean fclean re